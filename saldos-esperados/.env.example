# Configuração da Base de Dados - PostgreSQL via SSH Tunnel
# Antes de usar, iniciar o túnel: make tunnel-start
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=saldos_esperados
DB_SSLMODE=disable

# Configuração do Servidor
SERVER_PORT=8080
GIN_MODE=debug

# =============================================
# SEGURANÇA - OBRIGATÓRIO EM PRODUÇÃO
# =============================================

# TLS/HTTPS Configuration
# ATENÇÃO: USE_TLS=true é OBRIGATÓRIO em produção!
USE_TLS=false
TLS_CERT_FILE=./certs/server.crt
TLS_KEY_FILE=./certs/server.key

# Session Secret (CRÍTICO)
# Gerar com: openssl rand -base64 32
# Deve ter pelo menos 32 caracteres
# MUDAR EM PRODUÇÃO!
SESSION_SECRET=change-this-to-a-random-32-char-secret-in-production!!

# CSRF Protection (CRÍTICO)
# Gerar com: openssl rand -hex 16
# Deve ter exatamente 32 caracteres
# MUDAR EM PRODUÇÃO!
CSRF_AUTH_KEY=change-this-exactly-32-chars!!

# Encryption Key para TOTP Secrets (CRÍTICO)
# Gerar com: openssl rand -hex 16
# Deve ter exatamente 32 caracteres (256 bits para AES-256)
# MUDAR EM PRODUÇÃO!
ENCRYPTION_KEY=change-this-exactly-32-chars!!



DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_PATH =/Balancetes
DROPBOX_REFRESH_TOKEN=

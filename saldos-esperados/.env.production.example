# Configuração da Base de Dados - Produção
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_segura
DB_NAME=saldos_esperados
DB_SSLMODE=require

# Configuração do Servidor - Produção
SERVER_PORT=443
SERVER_ENABLE_TLS=true
SERVER_TLS_CERT=/etc/letsencrypt/live/se.rswebportal.com/fullchain.pem
SERVER_TLS_KEY=/etc/letsencrypt/live/se.rswebportal.com/privkey.pem
GIN_MODE=release
